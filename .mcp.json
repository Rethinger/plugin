{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "qdrant": {
      "command": "uvx",
      "args": ["mcp-server-qdrant"],
      "env": {
        "QDRANT_URL": "http://192.168.0.109:6333",
        "QDRANT_API_KEY": "",
        "COLLECTION_NAME": "code-search",
        "EMBEDDING_PROVIDER": "fastembed",
        "EMBEDDING_MODEL": "all-MiniLM-L6-v2"
      }
    }
  }
}
