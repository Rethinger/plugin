      "command": [
        "npx",
        "-y",
        "@21st-dev/magic@latest"
      ],
      "environment": {
        "API_KEY": "ea918619130e3be6c9e0a74cb8226dcd4f868b5fd0eb0a4f6e1ff327891b9d06"
      },
      "enabled": true
    },
    "shadcn": {
